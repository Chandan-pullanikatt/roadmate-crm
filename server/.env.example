PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/roadmate
JWT_SECRET=your_jwt_secret_here_123456
CLIENT_URL=http://localhost:5173

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name

# Web Push (browser push notifications). Generate once with:
#   npx web-push generate-vapid-keys
# Keep them stable — changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@roadmate.team
